# 正式網域（設定後才會允許搜尋引擎索引，並用於 canonical / hreflang / sitemap）
NEXT_PUBLIC_SITE_URL=https://official.superb-tutor.com

# 聯絡表單寄送（Resend）。正式環境未設定時，表單會顯示「送出失敗」並保留使用者資料
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@superb-tutor.com
# 寄件網域需先在 Resend 驗證，例如 send.superb-tutor.com
CONTACT_FROM_EMAIL="SuperB 官網 <noreply@send.superb-tutor.com>"

# 選用：隱私友善、無 Cookie 的 Plausible 分析
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
